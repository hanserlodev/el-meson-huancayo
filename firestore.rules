rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Platos: lectura pública, escritura solo admin (custom claim admin==true)
    match /platos/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Reservas: cualquier visitante puede crear (validación en rules), solo dueño lee
    match /reservas/{id} {
      allow create: if request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.personas is int
        && request.resource.data.personas >= 1 && request.resource.data.personas <= 20
        && request.resource.data.hora is string
        && request.resource.data.hora >= "11:00" && request.resource.data.hora <= "23:00"
        && request.resource.data.fecha is string;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid
        || request.auth != null && request.auth.token.admin == true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Pedidos: requiere auth para crear, lectura dueño/admin
    match /pedidos/{id} {
      allow create: if request.auth != null
        || request.resource.data.items is list; // permite invitado si luego migra a auth
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Usuarios (si se añade auth)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
