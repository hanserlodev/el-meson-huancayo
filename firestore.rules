rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function tienePerfil() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function esAdminPorPerfil() {
      return tienePerfil()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || esAdminPorPerfil());
    }

    // Platos, categorias, ofertas: lectura publica, escritura solo admin
    match /platos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categorias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ofertas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Cupones: lectura publica para validarlos en el carrito, escritura solo admin
    match /cupones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Resenas: lectura publica (aprobadas filtradas en cliente), create validado, update/delete solo admin
    match /resenas/{id} {
      allow read: if true;
      allow create: if request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comentario is string && request.resource.data.comentario.size() >= 5
        && request.resource.data.platoId is string;
      allow update, delete: if isAdmin();
    }
    // Reservas: create validado estricto, read/update/delete solo admin
    match /reservas/{id} {
      allow create: if request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2
        && request.resource.data.personas is int && request.resource.data.personas >= 1 && request.resource.data.personas <= 20
        && request.resource.data.hora is string && request.resource.data.hora >= "11:00" && request.resource.data.hora <= "23:00"
        && request.resource.data.fecha is string && request.resource.data.fecha.size() == 10
        && request.resource.data.estado == "confirmada";
      allow read, update, delete: if isAdmin();
    }
    // Espejo de reservas SIN datos personales: lectura publica para calcular aforo
    // (soft-check best-effort en cliente), escritura validada al crear reserva.
    match /reservas_aforo/{id} {
      allow read: if true;
      allow create: if request.resource.data.fecha is string && request.resource.data.fecha.size() == 10
        && request.resource.data.sede is string
        && request.resource.data.personas is int && request.resource.data.personas >= 1 && request.resource.data.personas <= 20
        && request.resource.data.estado == "confirmada";
      allow update, delete: if isAdmin();
    }
    // Pedidos: el cliente puede leer los suyos (uid), el admin todos.
    match /pedidos/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if request.resource.data.items is list && request.resource.data.items.size() >= 1
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.codigo is string && request.resource.data.codigo.size() >= 8
        && request.resource.data.estado == "pendiente"
        && (request.resource.data.uid == request.auth.uid || !("uid" in request.resource.data))
        && (!("descuento" in request.resource.data)
          || (request.resource.data.descuento is number && request.resource.data.descuento >= 0));
      allow update, delete: if isAdmin();
    }
    // Espejo público de seguimiento SIN datos personales. El ID es el código
    // del pedido: solo `get` por código exacto, nunca `list` (no enumerable).
    match /pedidos_seguimiento/{codigo} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.codigo is string
        && request.resource.data.codigo.size() >= 8
        && request.resource.data.estado == "pendiente"
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.total <= 5000
        && request.resource.data.items is list && request.resource.data.items.size() <= 50;
      allow update, delete: if isAdmin();
    }
    // Perfil de cliente: cada usuario lee/edita el suyo sin poder cambiar rol ni correo.
    match /usuarios/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.rol == "cliente"
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }
    match /users/{uid} { allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == uid); }
  }
}
